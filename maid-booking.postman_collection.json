{
  "info": {
    "name": "Maid Booking Service",
    "description": "Run the folders top to bottom (or use Collection Runner). Onboard Maid saves {{maidId}}; Book Scheduled saves {{bookingId}}. {{tomorrow}} is set automatically by the collection pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "maidId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "tomorrow",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date(); d.setDate(d.getDate() + 1);",
          "const pad = n => String(n).padStart(2, '0');",
          "pm.collectionVariables.set('tomorrow', `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Maids",
      "item": [
        {
          "name": "Onboard Maid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/maids",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "maids"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha\",\n  \"locality\": \"Koramangala\",\n  \"services\": [\n    \"CLEANING\",\n    \"COOKING\"\n  ],\n  \"pricePerHour\": 200,\n  \"rating\": 4.5,\n  \"workStart\": \"08:00\",\n  \"workEnd\": \"18:00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"maidId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Maid",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/maids/{{maidId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "maids",
                "{{maidId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search Maids",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/maids?locality=Koramangala&service=CLEANING&minRating=4&maxPrice=250",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "maids"
              ],
              "query": [
                {
                  "key": "locality",
                  "value": "Koramangala"
                },
                {
                  "key": "service",
                  "value": "CLEANING"
                },
                {
                  "key": "minRating",
                  "value": "4"
                },
                {
                  "key": "maxPrice",
                  "value": "250"
                }
              ]
            },
            "description": "All query params are optional."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Book Scheduled",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
