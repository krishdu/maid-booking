            }
          ]
        },
        {
          "name": "Double Booking (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "description": "Overlaps the scheduled booking, so it is rejected.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maidId\": \"{{maidId}}\",\n  \"type\": \"SCHEDULED\",\n  \"start\": \"{{tomorrow}}T11:00:00\",\n  \"hours\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Book Instant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "description": "Starts now. Returns 409 if the current time is outside the maid's working hours (08:00-18:00).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maidId\": \"{{maidId}}\",\n  \"type\": \"INSTANT\",\n  \"hours\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
